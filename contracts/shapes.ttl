@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ont: <https://ont.paiml.dev/v1alpha1/> .

<https://ont.paiml.dev/v1alpha1/shape/demo-bin-v1> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/demo/DemoBin> ;
    sh:closed true ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/demo/id> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:pattern "^lesson[0-9]+_[a-z0-9_]+$" ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/demo/crate> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:pattern "^ch[0-9]+-[a-z0-9-]+$" ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/demo/source> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:pattern "^crates/.+/src/bin/.+\\.rs$" ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/demo/has_contract_doc> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/demo/asserts_contract> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/demo/prints_contract_ok> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/demo/assert_before_ok> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

